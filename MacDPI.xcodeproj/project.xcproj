{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "MacDPI", "target-membership": [ "MacDPI" ] },
    { "kind": "folder", "path": "MacDPITests", "target-membership": [ "MacDPITests" ] },
    { "kind": "folder", "path": "MacDPIUITests", "target-membership": [ "MacDPIUITests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/MacDPI.app", "id": "5BA3F884309B46F6009F509F", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/MacDPITests.xctest", "id": "5BA3F891309B46F7009F509F", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/MacDPIUITests.xctest", "id": "5BA3F89B309B46F7009F509F", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/io.github.latryee.MacDPI.TransparentProxy.systemextension", "id": "5B3E4CF2309BACE600CA032B", "type": "wrapper.system-extension", "index": false, "target-membership": [ { "build-phase": "MacDPI/copy/Embed MacDPI System Extension", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/io.github.latryee.MacDPI.DNSProxy.systemextension", "id": "5B89BE4C309BE9FF0073F419", "type": "wrapper.system-extension", "index": false, "target-membership": [ { "build-phase": "MacDPI/copy/Embed MacDPI System Extension", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
      ],
    },
    { "kind": "folder", "path": "MacDPI/Core", "target-membership": [ "MacDPIDNSProxy", "MacDPITransparentProxy" ] },
    { "kind": "folder", "path": "Extension", "target-membership": [ "MacDPIDNSProxy", "MacDPITransparentProxy" ] },
    { "kind": "folder", "path": "IntegrationSupport", "target-membership": [ "MacDPI", "MacDPIDNSProxy", "MacDPITransparentProxy" ] },
  ],
  "targets": [
    {
      "name": "MacDPI",
      "id": "5BA3F883309B46F6009F509F",
      "product": "Products/MacDPI.app",
      "product-type": "application",
      "dependencies": [
        "MacDPITransparentProxy",
        "MacDPIDNSProxy",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed MacDPI System Extension",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(SYSTEM_EXTENSIONS_FOLDER_PATH)",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CLANG_ENABLE_OBJC_ARC": "YES",
        "CODE_SIGN_ENTITLEMENTS": "MacDPI/App.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_MacDPIIntegrationBuild": "$(MACDPI_INTEGRATION_BUILD)",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "Copyright 2026 MacDPI contributors. MIT License.",
        "INFOPLIST_KEY_NSSystemExtensionUsageDescription": "MacDPI uses an approved local networking extension to handle supported outbound traffic. No remote VPN or trusted certificate installation is used.",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "12.0",
        "OTHER_CFLAGS": [
          "$(inherited)",
          "-fblocks",
        ],
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-framework",
          "Security",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "io.github.latryee.MacDPI",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "nonisolated",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_OBJC_BRIDGING_HEADER": "IntegrationSupport/ControlChannel.h",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
      },
    }, {
      "name": "MacDPITests",
      "id": "5BA3F890309B46F7009F509F",
      "product": "Products/MacDPITests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "MacDPI",
      "dependencies": [
        "MacDPI",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "14.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "io.github.latryee.MacDPITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/MacDPI.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/MacDPI",
      },
    }, {
      "name": "MacDPIUITests",
      "id": "5BA3F89A309B46F7009F509F",
      "product": "Products/MacDPIUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "MacDPI",
      "dependencies": [
